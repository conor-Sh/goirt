# Tiny committed Wexford sample (default). CI uses this.
VITE_FIELDS_URL=/fixtures/wexford-sample.geojson
# Leave empty to run without a basemap (used by the CI smoke test).
VITE_BASEMAP_URL=
VITE_CROPS_URL=/data/crops.json
# Committed low-zoom overview sample (default). CI uses this.
VITE_OVERVIEW_URL=/data/overview-sample.geojson
VITE_PLACES_URL=/data/places-sample.json
# The local statewide build is configured in .env.full.example.
